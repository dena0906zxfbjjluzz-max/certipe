# Copia a secrets.toml (NO subas secrets.toml a GitHub).
# En Streamlit Cloud: Settings → Secrets (pegar lo mismo).

[credenciales]
usuario = "admin"
clave = "cambia-esta-clave"
# Seed Ed25519: 64 caracteres hex (32 bytes) — igual que validador
LLAVE_PRIVADA = "REEMPLAZAR_CON_64_CHARS_HEX"
nombre_institucion = "Academia Demo Perú"
institution_id = "academia-demo-pe"
